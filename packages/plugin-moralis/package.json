{
  "name": "@orbytejs/plugin-moralis",
  "version": "0.1.1",
  "description": "Moralis integration for Orbyte",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
