  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "moralis": "^2.26.2"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "orbytejs": "*"
  },
  "peerDependencies": {
    "orbytejs": "^0.1.0"
  },
  "license": "MIT"
}
