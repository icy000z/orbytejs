{
  "name": "@orbytejs/server",
  "version": "0.1.1",
  "description": "Backend HTTP and Webhook server for Orbyte",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "hpp": "^0.2.3",
    "hyperswarm": "^4.7.4",
    "b4a": "^1.6.6",
    "orbytejs": "*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/hpp": "^0.2.6",
    "@types/express-rate-limit": "^5.1.3"
  },
  "peerDependencies": {
    "orbytejs": "^0.1.0"
  },
  "license": "MIT"
}
