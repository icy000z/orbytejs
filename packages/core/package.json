{
  "name": "orbytejs",
  "version": "0.1.1",
  "description": "The Web3 framework that makes blockchain development stupidly simple",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./chains": {
      "import": "./dist/chains.js",
      "require": "./dist/chains.cjs",
      "types": "./dist/chains.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "web3",
    "ethereum",
    "blockchain",
    "framework",
    "viem",
    "dapp",
    "smart-contracts",
    "erc20",
    "nft",
    "defi"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/icy000z/orbyte"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
